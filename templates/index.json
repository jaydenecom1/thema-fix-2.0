    "faq": {
      "type": "faq",
      "blocks": {
        "item_paFPYf": {
          "type": "item",
          "settings": {
            "title": "How long will it take to receive my order?",
            "content": "<p>Delivery times may vary slightly depending on your location. Orders are typically processed and dispatched within 1–3 business days. Once shipped, delivery usually takes 5–9 business days.</p><p>Please note that during busy periods, or due to customs checks and local carrier delays, delivery may occasionally take a little longer.</p><p>As soon as your order has been shipped, you will receive a confirmation email with your tracking details, so you can follow your package every step of the way.</p>"
          }
        },
        "166442457738b23caf-0": {
          "type": "item",
          "settings": {
            "title": "Do you offer free shipping?",
            "content": "<p>Yes, we offer free premium shipping on every order. No additional shipping costs at checkout.</p><p>Every shipment includes full tracking, so you can follow your order every step of the way and shop with complete confidence.</p>"
          }
        },
        "166442457738b23caf-1": {
          "type": "item",
          "settings": {
            "title": "How many days do I have to return my order?",
            "content": "<p>You may return your item within <strong>30 days of receiving your order</strong>.</p><p>To be eligible for a return, the item must be unused, unwashed, and in its original condition, with all tags still attached.</p><p>For more information about returns, please visit our full Return Policy.</p>"
          }
        },
        "166442457738b23caf-2": {
          "type": "item",
          "settings": {
            "title": "Are your clothes eco-friendly?",
            "content": "<p>We believe fashion should not only look good, but also be made with care.</p><p>Where possible, we work with suppliers who use more responsible materials and production methods. We are always looking for ways to improve our collections and make more conscious choices.</p><p>Choosing George & Grace London means choosing timeless style with a thoughtful approach.</p>"
          }
        },
        "item_i7Uw3z": {
          "type": "item",
          "settings": {
            "title": "Need more help?",
            "content": "<p>Have a question or need advice? Don’t hesitate to contact us. We are here to assist you and provide expert guidance.<br/><br/>You can contact us by email at <a href=\"/pages/contact\" title=\"Contact\"><strong>info@georgegracestore.com</strong></a> or by using the contact form on our website.</p><p>Our customer support team aims to respond within <strong>24 hours</strong>.<br/></p><p>Mon / Fri 09:00 - 17:00</p><p>Sat / Sun 10:00 - 15:00</p>"
          }
        }
      },
