    "faq": {
      "type": "faq",
      "blocks": {
        "item_paFPYf": {
          "type": "item",
          "settings": {
            "title": "How long will it take to receive my order?",
            "content": "<p>Delivery times may vary slightly depending on your location. Orders are typically processed and dispatched within 1–3 business days. Once shipped, delivery usually takes 5–12 business days.</p><p>Please note that during busy periods, or due to customs checks and local carrier delays, delivery may occasionally take a little longer.</p><p>As soon as your order has been shipped, you will receive a confirmation email with your tracking details, so you can follow your package every step of the way.</p>"
          }
        },
        "166442457738b23caf-0": {
          "type": "item",
          "settings": {
            "title": "Do you offer free shipping?",
            "content": "<p>Yes, we offer free premium shipping on every order. No additional shipping costs at checkout.</p><p>Every shipment includes full tracking, so you can follow your order every step of the way and shop with complete confidence.</p>"
          }
        },
        "166442457738b23caf-1": {
          "type": "item",
          "settings": {
            "title": "Can I return my order",
            "content": "<p>You may return your item within 30 days of receiving your order.</p><p>Only the sleep pillow comes with a 100-night trial. </p><p>To be eligible for a return, the item must be unused, unwashed, and in its original condition, with all tags still attached.</p><p>For more information about returns, please visit our full Return Policy.</p>"
          }
        },
        "166442457738b23caf-2": {
          "type": "item",
          "settings": {
            "title": "Are your products eco-friendly?",
            "content": "<p>Yes. We aim to offer products that are made with quality, durability and more responsible choices in mind. Where possible, we work with materials and suppliers that help reduce unnecessary waste and environmental impact.</p><p>We’re continuously looking for ways to make better and more responsible choices across our collection. </p>"
          }
        },
        "item_i7Uw3z": {
          "type": "item",
          "settings": {
            "title": "Need more help?",
            "content": "<p>Have a question or need advice? Don’t hesitate to contact us. We are here to assist you and provide expert guidance.<br/><br/>You can contact us by email at <a href=\"/pages/contact\" title=\"Contact\"><strong>info@sorevanasleep.com</strong></a> or by using the contact form on our website.</p><p>Our customer support team aims to respond within <strong>24 hours</strong>.<br/></p><p>Mon / Fri 09:00 - 17:00</p><p>Sat / Sun 10:00 - 14:00</p>"
          }
        }
      },
