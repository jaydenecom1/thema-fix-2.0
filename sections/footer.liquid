 <div class="custom-footer-luxe"><div class="custom-footer-luxe" style="border: 4px solid red !important; display: block !important; visibility: visible !important; opacity: 1 !important;">

 <div class="page-width custom-footer-luxe__inner">
    <div class="custom-footer-luxe__grid">

      <div class="custom-footer-luxe__column custom-footer-luxe__brand">
        {%- if section.settings.logo != blank -%}
          <img
            src="{{ section.settings.logo | image_url: width: 360 }}"
            alt="{{ shop.name }}"
            class="custom-footer-luxe__logo"
          >
        {%- else -%}
          <h3 class="custom-footer-luxe__shop-name">{{ shop.name }}</h3>
        {%- endif -%}
      </div>

      <div class="custom-footer-luxe__column">
  <h4 class="custom-footer-luxe__heading">Need Help?</h4>
  <div class="custom-footer-luxe__text rte">
    {{ section.settings.support_text }}
  </div>

  <div class="custom-footer-luxe__hours-block">
    <h4 class="custom-footer-luxe__heading">Opening Hours</h4>
    <p class="custom-footer-luxe__hours">
      {{ section.settings.opening_hours | newline_to_br }}
    </p>
  </div>
</div>


      <div class="custom-footer-luxe__column">
        <h4 class="custom-footer-luxe__heading">Information</h4>
        {%- if section.settings.information_menu != blank -%}
          <ul class="custom-footer-luxe__links" role="list">
            {%- for link in section.settings.information_menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <div class="custom-footer-luxe__column">
        <h4 class="custom-footer-luxe__heading">Policies</h4>
        {%- if section.settings.policies_menu != blank -%}
          <ul class="custom-footer-luxe__links" role="list">
            {%- for link in section.settings.policies_menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

    </div>

    <div class="custom-footer-luxe__bottom">
      <div class="custom-footer-luxe__bottom-content">
        
        </p>
        <p class="custom-footer-luxe__copyright">
          &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.
        </p>
      </div>
    </div>
  </div>
</div>

<style>
  .custom-footer-luxe {
    background-color: #FAF2E6;
    color: #1e1c1a;
    padding: 88px 28px 30px;
    font-family: "Montserrat", sans-serif;
  }

  .custom-footer-luxe__inner {
    max-width: 1320px;
    margin: 0 auto;
  }

  .custom-footer-luxe__grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr 1fr;
    gap: 56px;
    align-items: start;
  }

  .custom-footer-luxe__column {
    min-width: 0;
  }

  .custom-footer-luxe__brand {
    padding-right: 16px;
  }

  .custom-footer-luxe__logo {
    max-width: 190px;
    width: 100%;
    height: auto;
    display: block;
    
  }
  .custom-footer-luxe__hours-block {
  margin-top: 24px;
}


  .custom-footer-luxe__shop-name {
    margin: 0;
    font-size: 26px;
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: 0.03em;
  }

  .custom-footer-luxe__heading {
    margin: 0 0 18px;
    font-size: 12px;
    line-height: 1.4;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #2a2724;
  }

  .custom-footer-luxe__text,
  .custom-footer-luxe__text p,
  .custom-footer-luxe__links a,
  .custom-footer-luxe__hours,
  .custom-footer-luxe__copyright {
    font-size: 14px;
    line-height: 2;
    font-weight: 400;
    color: #4d4741;
    text-decoration: none;
  }

  .custom-footer-luxe__text p {
  margin: 0 0 14px 0;
  max-width: 280px;
}

.custom-footer-luxe__text p:last-child {
  margin-bottom: 0;
}


  .custom-footer-luxe__links {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .custom-footer-luxe__links li {
    margin: 0 0 8px;
  }

  .custom-footer-luxe__links a {
    transition: opacity 0.2s ease;
  }

  .custom-footer-luxe__links a:hover {
    opacity: 0.65;
  }

  .custom-footer-luxe__bottom {
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid rgba(30, 28, 26, 0.10);
  }

  .custom-footer-luxe__bottom-content {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    align-items: flex-end;
  }

  .custom-footer-luxe__hours,
  .custom-footer-luxe__copyright {
    margin: 0;
  }

  .custom-footer-luxe__hours {
    max-width: 420px;
  }

  @media screen and (max-width: 1100px) {
    .custom-footer-luxe {
      padding: 68px 22px 26px;
    }

    .custom-footer-luxe__grid {
      grid-template-columns: 1fr 1fr;
      gap: 40px 30px;
    }

    .custom-footer-luxe__bottom-content {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media screen and (max-width: 640px) {
    .custom-footer-luxe {
      padding: 52px 16px 24px;
    }

    .custom-footer-luxe__grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .custom-footer-luxe__logo {
      max-width: 160px;
    }
    .custom-footer-luxe__hours-block {
  margin-top: 24px;
}


    .custom-footer-luxe__bottom {
      margin-top: 36px;
      padding-top: 18px;
    }
  }
</style>

{% schema %}
{
  "name": "Luxury footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo afbeelding"
    },
    {
      "type": "richtext",
      "id": "support_text",
      "label": "Need Help tekst",
      "default": "<p>Need help with your order, shipping or product questions? Our support team is here to assist you with care.</p>"
    },
    {
      "type": "link_list",
      "id": "information_menu",
      "label": "Information menu"
    },
    {
      "type": "link_list",
      "id": "policies_menu",
      "label": "Policies menu"
    },
    {
      "type": "textarea",
      "id": "opening_hours",
      "label": "Opening Hours",
      "default": "Monday - Friday: 9:00 - 17:00\nSaturday: Closed\nSunday: Closed"
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "Luxury footer"
    }
  ]
}
{% endschema %}
